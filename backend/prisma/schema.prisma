generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== USER MODELS ==========

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  profileImage       String?
  emailVerified      Boolean         @default(false)
  emailVerifyToken   String?         @unique
  emailVerifyExpires DateTime?
  otpCode            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int             @default(0)
  otpLastSentAt      DateTime?
  isDisabled         Boolean         @default(false)
  promotionalEmails  Boolean         @default(false)
  addresses          Address[]
  orders             Order[]
  quotes             CheckoutQuote[]
  wishlist           Wishlist[]
  cart               Cart?
  passwordReset      PasswordReset?
  reviews            Review[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model SiteSetting {
  key              String    @id
  value            Json
  version          Int       @default(1)
  publishedValue   Json?
  publishedVersion Int       @default(0)
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
}

model MpesaPayment {
  id                 String              @id @default(cuid())
  checkoutRequestId  String?             @unique
  merchantRequestId  String?
  orderNumber        String?
  orderId            String?
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  environment        String?
  merchantShortcode  String?
  merchantIdentity   String?
  idempotencyKey     String?
  requestHash        String?
  callbackKeyHash    String?
  reference          String?             @unique
  phone              String
  amount             Decimal             @db.Decimal(14, 2)
  status             String              @default("INITIATING")
  resultCode         Int?
  resultDesc         String?
  receiptNumber      String?
  rawCallback        Json?
  queryEvidence      Json?
  reviewCode         String?
  lastErrorCode      String?
  providerVerifiedAt DateTime?
  confirmedAt        DateTime?
  nextReconcileAt    DateTime?
  reconcileCount     Int                 @default(0)
  reconcileLease     String?
  leaseExpiresAt     DateTime?
  events             MpesaPaymentEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orderId, idempotencyKey])
  @@unique([environment, receiptNumber])
  @@index([status, nextReconcileAt])
  @@index([orderId, createdAt])
}

model MpesaPaymentEvent {
  id          String       @id @default(cuid())
  paymentId   String
  payment     MpesaPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  source      String
  fingerprint String
  details     Json
  createdAt   DateTime     @default(now())

  @@unique([paymentId, fingerprint])
  @@index([paymentId, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  street     String
  city       String
  county     String
  postalCode String?
  isDefault  Boolean  @default(false)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id])
  items      CartItem[]
  subtotal   Decimal    @default(0) @db.Decimal(14, 2)
  discount   Decimal    @default(0) @db.Decimal(14, 2)
  total      Decimal    @default(0) @db.Decimal(14, 2)
  couponCode String?
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id])
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  price     Decimal        @db.Decimal(14, 2)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ADMIN MODELS ==========

model Admin {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  password     String
  role         AdminRole     @default(ADMIN)
  lastLogin    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  action    String
  details   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ========== PRODUCT MODELS ==========

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  price          Decimal          @db.Decimal(14, 2)
  compareAtPrice Decimal?         @db.Decimal(14, 2)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  designerId     String?
  designer       Designer?        @relation(fields: [designerId], references: [id])
  tags           String[]
  images         ProductImage[]
  variants       ProductVariant[]
  discountId     String?
  discount       Discount?        @relation(fields: [discountId], references: [id])
  isActive       Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  isDemo         Boolean          @default(false)
  collection     String?
  specifications Json             @default("{}")
  deletedAt      DateTime?
  rating         Float            @default(0)
  reviewsCount   Int              @default(0)
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  Wishlist[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  sku        String      @unique
  attributes Json        @default("{}")
  price      Decimal?    @db.Decimal(14, 2)
  isActive   Boolean     @default(true)
  stock      Stock?
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId, isActive])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  headerImage   String?
  products      Product[]
  order         Int        @default(0)
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[] @relation("CategoryTree")
  attributeKeys String[]   @default([])
  isActive      Boolean    @default(true)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId, order])
}

model Designer {
  id               String    @id @default(cuid())
  designerId       String    @unique
  fullName         String
  specialty        String
  location         String    @default("Mombasa")
  profileImage     String?
  spotlightHeading String?
  spotlightText    String?
  isActive         Boolean   @default(true)
  isDemo           Boolean   @default(false)
  deletedAt        DateTime?
  products         Product[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProductImage {
  id                 String    @id @default(cuid())
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id])
  url                String
  alt                String?
  isMain             Boolean   @default(false)
  order              Int       @default(0)
  width              Int?
  height             Int?
  isPlaceholder      Boolean   @default(false)
  sourceUrl          String?
  license            String?
  credit             String?
  cloudinaryPublicId String?   @unique
  version            Int       @default(1)
  deletedAt          DateTime?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== STOCK MODELS ==========

model Stock {
  id             String           @id @default(cuid())
  variantId      String           @unique
  variant        ProductVariant   @relation(fields: [variantId], references: [id])
  quantity       Int              @default(0)
  reserved       Int              @default(0)
  maxStock       Int              @default(100)
  minThreshold   Int              @default(10)
  status         StockStatus      @default(OUT_OF_STOCK)
  lastRestocked  DateTime?
  restockHistory RestockHistory[]
  stockLogs      StockLog[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model RestockHistory {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id])
  quantity  Int
  reason    String
  adminId   String?
  createdAt DateTime @default(now())
}

model StockLog {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id])
  previousStock Int
  newStock      Int
  action        String
  adminId       String?
  createdAt     DateTime @default(now())
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// ========== DISCOUNT MODELS ==========

model Discount {
  id         String       @id @default(cuid())
  name       String
  type       DiscountType @default(PERCENTAGE)
  value      Decimal      @db.Decimal(14, 2)
  couponCode String?      @unique
  applyTo    ApplyTo      @default(ALL)
  targetIds  String[]
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean      @default(true)
  isDemo     Boolean      @default(false)
  products   Product[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ApplyTo {
  ALL
  CATEGORY
  SELECTED
}

// ========== ORDER MODELS ==========

model CheckoutQuote {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  request     Json
  snapshot    Json
  fingerprint String
  expiresAt   DateTime
  consumedAt  DateTime?
  order       Order?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

enum ReservationStatus {
  COMMITTED
  HELD
  RELEASED
  EXPIRED
}

model Order {
  id                           String            @id @default(cuid())
  orderNumber                  String            @unique
  userId                       String
  user                         User              @relation(fields: [userId], references: [id])
  items                        OrderItem[]
  payments                     MpesaPayment[]
  subtotal                     Decimal           @db.Decimal(14, 2)
  discount                     Decimal           @default(0) @db.Decimal(14, 2)
  tax                          Decimal           @db.Decimal(14, 2)
  shippingCost                 Decimal           @db.Decimal(14, 2)
  total                        Decimal           @db.Decimal(14, 2)
  quoteId                      String?           @unique
  quote                        CheckoutQuote?    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  idempotencyKey               String?
  requestHash                  String?
  addressSnapshot              Json?
  pricingSnapshot              Json?
  reservationStatus            ReservationStatus @default(COMMITTED)
  reservationExpiresAt         DateTime?
  status                       OrderStatus       @default(PENDING)
  paymentMethod                PaymentMethod
  paymentStatus                PaymentStatus     @default(PENDING)
  isDemo                       Boolean           @default(false)
  deliveryMethod               DeliveryMethod    @default(STANDARD)
  addressId                    String
  address                      Address           @relation(fields: [addressId], references: [id])
  trackingNumber               String?
  notes                        String?
  cancellationReason           String?
  refundApproved               Boolean           @default(false)
  pickedUpAt                   DateTime?
  autoStageEnabled             Boolean           @default(true)
  autoStagePaused              Boolean           @default(false)
  autoStageLastUpdate          DateTime?
  awaitingRefundAt             DateTime?
  refundNotificationSent       Boolean           @default(false)
  refundNotificationLastSentAt DateTime?
  trackingHistory              TrackingEvent[]
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([reservationStatus, reservationExpiresAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  productId         String
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku               String?
  variantAttributes Json?
  productName       String
  productPrice      Decimal         @db.Decimal(14, 2)
  quantity          Int
  subtotal          Decimal         @db.Decimal(14, 2)
  pricingSnapshot   Json?
  productImage      String?
}

model TrackingEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  description String
  location    String?
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  AWAITING_REFUND
  RETURNED
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  STORE_PICKUP
  SAME_DAY
  STANDARD
}
