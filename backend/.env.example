# Local development only. Never put production credentials in this template.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://apex:local_development_only@127.0.0.1:5432/apex_development
DIRECT_URL=postgresql://apex:local_development_only@127.0.0.1:5432/apex_development

# Set unique signing secrets in backend/.env, not in tracked files.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Local demo initialization is opt-in and preserves existing records.
# Supply these privately before creating the initial staff account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOW_DEMO_INITIALIZATION=false
# Demo catalog visibility is ignored in production and never enables payments.
ALLOW_DEMO_CATALOG=false
# Quotes can be reviewed without creating orders. Reservation creation is opt-in.
ENABLE_ORDER_RESERVATIONS=false
# Development/test only; also requires demo catalog visibility and reservations.
ALLOW_DEMO_ORDERS=false
# The public demonstration store, in any NODE_ENV: true shows and sells only sample products,
# lets visitors pay sample orders with a demonstration payment (no money) and play the store's
# part for their own orders, and refuses MPESA_ENVIRONMENT=production. Only true or false.
DEMONSTRATION_STORE=false
# Most sample orders one account may create in 24 hours; a positive whole number (default 10).
DEMO_ORDER_DAILY_LIMIT=10
# Days after which the maintenance step deletes visitors' sample orders, giving their sample stock
# back; orders with an M-Pesa attempt or money evidence are kept. A whole number from 1 to 3650 (default 7).
SAMPLE_ORDER_RETENTION_DAYS=7
# Optional complete versioned pricing profile; see SETUP.md. Empty uses defaults.
CHECKOUT_POLICY_JSON=
# Destructive resets remain a separate, explicit operation.
ALLOW_LOCAL_DATABASE_RESET=false

# Opt in only on an always-on host: payment checks every 15 seconds, reservation
# expiry and email retries every 60 seconds, sample-order deletion every hour.
BACKGROUND_JOBS_ENABLED=false
# Serverless hosts: the daily Vercel cron calls GET /api/internal/maintenance with
# "Authorization: Bearer <CRON_SECRET>". Use 16+ characters without spaces; empty disables it.
CRON_SECRET=
# Optional complete versioned return policy; see SETUP.md. Empty uses the approved defaults.
RETURN_POLICY_JSON=
# Development/test only: also email customers about labelled demo orders. Ignored in production.
DEMO_NOTIFICATIONS_ENABLED=false

# Optional external services: leave unconfigured for local checks.
# Cloudinary image uploads, server-only: cloudinary://<api_key>:<api_secret>@<cloud_name>.
# Never commit it or expose it through a VITE_ variable. Empty disables uploads;
# HTTPS image addresses keep working.
CLOUDINARY_URL=
# Upload folder and public-ID prefix: lowercase letters, digits and hyphens, separated by /.
CLOUDINARY_UPLOAD_PREFIX=apex-cart

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
GMAIL_FROM=
# Optional public HTTPS address of the email logo mark, shown beside the live "Apex Cart" name,
# e.g. https://<your-site>/brand/apex-cart-mark-gold-128.png. Empty shows the name only.
EMAIL_LOGO_URL=
ENABLE_EMAIL_VERIFICATION=false

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_SANDBOX_SIMULATE=false
ENABLE_MPESA=false
# Separate live activation gate; true only on an approved production runtime.
MPESA_LIVE_PAYMENTS_ENABLED=false
# Sandbox STK tests may deduct funds; approve the recipient and amount first.
# Set an explicitly approved whole-KES maximum before any sandbox/live request.
MPESA_MAX_AMOUNT=
# Comma-separated approved Kenyan sandbox recipient numbers; never production customers.
MPESA_SANDBOX_ALLOWED_PHONES=
# Sandbox may operate only on demo orders, with this additional non-production opt-in.
MPESA_ALLOW_DEMO_SANDBOX=false
# Optional callback-only listener for a local sandbox tunnel; never expose the main API.
ENABLE_SANDBOX_CALLBACK=false
SANDBOX_CALLBACK_PORT=4285
ENABLE_CARD_PAYMENT=false

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
# Accounts one client address may open in an hour; every sign-up counts (default 5).
REGISTRATION_LIMIT_PER_HOUR=5
# Proxies in front of the API to trust for the client's address (0-9). Leave unset: 1 on Vercel, 0 elsewhere.
# Set it only when a proxy you control replaces X-Forwarded-For; trusting one a client can reach lets it forge addresses.
# TRUST_PROXY_HOPS=
