# Local development only. Never put production credentials in this template.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://apex:local_development_only@127.0.0.1:5432/apex_development
DIRECT_URL=postgresql://apex:local_development_only@127.0.0.1:5432/apex_development

# Set unique signing secrets in backend/.env, not in tracked files.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Local demo initialization is opt-in and preserves existing records.
# Supply these privately before creating the initial staff account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOW_DEMO_INITIALIZATION=false
# Demo catalog visibility is ignored in production and never enables payments.
ALLOW_DEMO_CATALOG=false
# Quotes can be reviewed without creating orders. Reservation creation is opt-in.
ENABLE_ORDER_RESERVATIONS=false
# Development/test only; also requires demo catalog visibility and reservations.
ALLOW_DEMO_ORDERS=false
# Optional complete versioned pricing profile; see SETUP.md. Empty uses defaults.
CHECKOUT_POLICY_JSON=
# Destructive resets remain a separate, explicit operation.
ALLOW_LOCAL_DATABASE_RESET=false

# Opt in only on an intentional operational environment.
# Runs reservation expiry plus legacy auto-stage, refund-email and image-session jobs.
BACKGROUND_JOBS_ENABLED=false

# Optional external services: leave unconfigured for local checks.
IMAGE_HOST_API_URL=
IMAGE_HOST_LOGIN_URL=
IMAGE_HOST_USERNAME=
IMAGE_HOST_PASSWORD=
IMAGE_HOST_UPLOAD_PRESET=
IMAGE_HOST_FOLDER=
IMAGE_HOST_SESSION_REFRESH=45

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
GMAIL_FROM=
EMAIL_LOGO_URL=
ENABLE_EMAIL_VERIFICATION=false

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_SANDBOX_SIMULATE=false
ENABLE_MPESA=false
ENABLE_CARD_PAYMENT=false

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
